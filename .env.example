# Copy to .env.local and adjust. Every variable is optional.
# Only VITE_* variables reach the browser bundle — never put secrets in them.

# Pre-fills the "Model address" field on the setup screen.
# Must be an https:// URL that serves the file with CORS headers allowing this site,
# e.g. a copy of gemma-4-E2B-it-web.task hosted on your own bucket or CDN.
VITE_MODEL_URL=

# Sub-path the app is served from (build time). Use "/SightEcho/" for GitHub Pages.
BASE_PATH=/
